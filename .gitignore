# The two synthetic CSVs are committed: git-backed Connect deployment has no
# build phase, so nothing can run generate_data.py before the content starts.
# They are text, small and regenerable, and they diff. The DuckDB file is none of
# those things, so it stays out; data-access code falls back to the CSVs.
data/*.duckdb
mcp/*.duckdb

# Copied into the MCP bundle at deploy time; python/trials.py is the original
mcp/trials.py

# Generated chart output from the ggsql runner
outputs/

# Claude Code
.claude/settings.local.json
